{
  "name": "Mezmo",
  "version": "1.0.0",
  "overview": "Monitor LaunchDarkly flag events in Mezmo.",
  "description": "This integration sends LaunchDarkly audit log events, including flag, project, and environment changes, to Mezmo.",
  "author": "LaunchDarkly",
  "supportEmail": "support@launchdarkly.com",
  "links": {
    "site": "https://www.mezmo.com/",
    "launchdarklyDocs": "https://launchdarkly.com/docs/integrations/mezmo",
    "privacyPolicy": "https://launchdarkly.com/policies/privacy/"
  },
  "categories": ["log-management"],
  "icons": {
    "square": "assets/images/square.svg",
    "horizontal": "assets/images/horizontal.svg"
  },
  "formVariables": [
    {
      "key": "ingestionKey",
      "name": "Mezmo ingestion key",
      "description": "Enter your [Mezmo ingestion key](https://docs.mezmo.com/docs/ingestion-key).",
      "type": "string",
      "placeholder": "1234567890abcdef1234567890abcdef",
      "isSecret": true
    },
    {
      "key": "level",
      "name": "Log level",
      "description": "The level of log messages from LaunchDarkly.",
      "type": "string",
      "isSecret": false,
      "defaultValue": "INFO",
      "isOptional": true
    }
  ],
  "capabilities": {
    "auditLogEventsHook": {
      "includeErrorResponseBody": true,
      "endpoint": {
        "url": "https://logs.logdna.com/logs/ingest?hostname=launchdarkly",
        "method": "POST",
        "headers": [
          {
            "name": "apikey",
            "value": "{{ingestionKey}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json; charset=UTF-8"
          }
        ]
      },
      "templates": {
        "default": "templates/template.json.hbs",
        "validation": "templates/template.json.hbs"
      },
      "defaultPolicy": [
        {
          "effect": "allow",
          "resources": ["proj/*:env/production:flag/*"],
          "actions": ["*"]
        }
      ]
    }
  }
}
