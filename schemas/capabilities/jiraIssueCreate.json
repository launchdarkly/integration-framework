{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "jiraIssueCreate": {
    "$id": "#/capabilities/jiraIssueCreate",
    "title": "Jira Issue Create",
    "description": "Allows LaunchDarkly products to create an issue in Jira issue tracker and receive the resulting identifiers.",
    "type": "object",
    "propertyNames": {
      "enum": ["name", "creationRequest", "issueCreateFormVariables"]
    },
    "required": ["creationRequest"],
    "properties": {
      "name": { "type": "string", "maxLength": 100 },
      "issueCreateFormVariables": {
        "type": "array",
        "items": { "$ref": "../definitions.json#/formVariable" },
        "default": []
      },
      "creationRequest": {
        "required": ["endpoint", "parser"],
        "properties": {
          "endpoint": { "$ref": "../definitions.json#/endpoint" },
          "jsonBody": { "$ref": "../definitions.json#/jsonBody" },
          "parser": { "$ref": "parser/parser.json#/jiraIssueCreateParser" }
        }
      }
    }
  }
}
